{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Australia/Brisbane",
  "enabledManagers": [
    "docker-compose",
    "github-actions",
    "terraform"
  ],
  "ignoreUnstable": true,
  "dependencyDashboard": {
    "enabled": true
  },
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Never move to pre-release tags, whatever the registry calls them",
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "!/(rc|alpha|beta|nightly|develop|dev|canary|preview|unstable|snapshot)/i"
    },
    {
      "description": "LinuxServer tags look like 4.0.20.3014-ls5 or v2.19.1-ls252; compare the numeric part",
      "matchPackageNames": [
        "ghcr.io/linuxserver/**"
      ],
      "versioning": "regex:^(?<prefix>v)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:-[0-9a-f]{7,9})?(?:_v[\\d.]+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Minor, patch, digest and pinDigest updates merge themselves once checks pass; the Plex-gated hourly deploy applies them when nobody is streaming",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Pinning GitHub Actions to a commit SHA keeps the same version, so it merges like a digest bump. Terraform and other 'pin' updates stay manual (they can change which version is used).",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Major updates only ever open a PR, assigned to the owner so the GitHub mobile app notifies them",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "assignees": [
        "nathanjnorris"
      ],
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "GitHub Actions major bumps are not a concern: they merge like minor/patch. Only Terraform and Docker majors need the owner.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "platformAutomerge": false,
      "assignees": [],
      "labels": [
        "dependencies"
      ]
    },
    {
      "description": "Sonarr 5.x is not what we run; stay on v4 until deliberately moved",
      "matchPackageNames": [
        "ghcr.io/linuxserver/sonarr"
      ],
      "allowedVersions": "/^4\\./"
    },
    {
      "description": "Cloudflare provider v5 is a staged migration (see Terraform uplift), not a bump",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "matchDepNames": [
        "cloudflare",
        "cloudflare/cloudflare"
      ]
    },
    {
      "description": "Group GitHub Actions bumps into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Terraform core is upgraded deliberately (workspace version change), never by a bump PR",
      "matchDepNames": [
        "hashicorp/terraform",
        "terraform"
      ],
      "enabled": false
    },
    {
      "description": "ubuntu-latest is a runner label, not a pin",
      "matchDepNames": [
        "ubuntu"
      ],
      "enabled": false
    }
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps"
}
