{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "terraform@anthropic-plugin-directory": true,
    "commit-commands@anthropic-plugin-directory": true,
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "superpowers@claude-plugins-official": true
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "renovate",
    "tailscale-docs"
  ],
  "permissions": {
    "allow": [
      "Bash(bash .claude/skills/servarr-doctor/scripts/doctor.sh:*)",
      "Bash(bash .claude/skills/servarr-ship/scripts/threads.sh:*)",
      "Bash(bash .claude/skills/servarr-ship/scripts/plan-diff.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(docker compose config:*)",
      "Bash(shellcheck:*)",
      "Bash(actionlint:*)",
      "Bash(cf cli search:*)",
      "Bash(cf zero-trust access applications list:*)",
      "Bash(cf tunnels list:*)",
      "mcp__plugin_terraform_terraform__search_providers",
      "mcp__plugin_terraform_terraform__get_provider_capabilities",
      "mcp__plugin_terraform_terraform__get_provider_details",
      "mcp__plugin_terraform_terraform__get_latest_provider_version",
      "mcp__renovate__validate_config",
      "mcp__renovate__lint_config",
      "mcp__renovate__explain_config",
      "mcp__plugin_terraform_terraform__list_terraform_orgs",
      "mcp__plugin_terraform_terraform__list_workspaces",
      "mcp__plugin_terraform_terraform__get_workspace_details",
      "mcp__plugin_terraform_terraform__list_runs",
      "mcp__plugin_terraform_terraform__get_run_details",
      "mcp__plugin_terraform_terraform__list_workspace_variables",
      "mcp__plugin_terraform_terraform__get_token_permissions"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git add -A:*)",
      "Bash(renovate:*)",
      "Bash(npx renovate:*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push*+*)",
      "Bash(*tailscale up*)",
      "Bash(*tailscale down*)",
      "Bash(*tailscale set*)",
      "mcp__plugin_terraform_terraform__action_run",
      "mcp__plugin_terraform_terraform__add_team_member",
      "mcp__plugin_terraform_terraform__apply_run",
      "mcp__plugin_terraform_terraform__attach_policy_set_to_workspaces",
      "mcp__plugin_terraform_terraform__attach_variable_set_to_projects",
      "mcp__plugin_terraform_terraform__attach_variable_set_to_workspaces",
      "mcp__plugin_terraform_terraform__create_no_code_workspace",
      "mcp__plugin_terraform_terraform__create_project",
      "mcp__plugin_terraform_terraform__create_run",
      "mcp__plugin_terraform_terraform__create_stack",
      "mcp__plugin_terraform_terraform__create_team",
      "mcp__plugin_terraform_terraform__create_variable_in_variable_set",
      "mcp__plugin_terraform_terraform__create_variable_set",
      "mcp__plugin_terraform_terraform__create_workspace",
      "mcp__plugin_terraform_terraform__delete_project",
      "mcp__plugin_terraform_terraform__delete_stack",
      "mcp__plugin_terraform_terraform__delete_team",
      "mcp__plugin_terraform_terraform__delete_variable_from_variable_set",
      "mcp__plugin_terraform_terraform__delete_variable_in_variable_set",
      "mcp__plugin_terraform_terraform__delete_variable_set",
      "mcp__plugin_terraform_terraform__delete_workspace",
      "mcp__plugin_terraform_terraform__delete_workspace_safely",
      "mcp__plugin_terraform_terraform__detach_policy_set_from_workspaces",
      "mcp__plugin_terraform_terraform__detach_variable_set_from_projects",
      "mcp__plugin_terraform_terraform__detach_variable_set_from_workspaces",
      "mcp__plugin_terraform_terraform__force_unlock_workspace",
      "mcp__plugin_terraform_terraform__grant_team_access",
      "mcp__plugin_terraform_terraform__remove_team_member",
      "mcp__plugin_terraform_terraform__revoke_team_access",
      "mcp__plugin_terraform_terraform__update_project",
      "mcp__plugin_terraform_terraform__update_stack",
      "mcp__plugin_terraform_terraform__update_team",
      "mcp__plugin_terraform_terraform__update_team_access",
      "mcp__plugin_terraform_terraform__update_variable_in_variable_set",
      "mcp__plugin_terraform_terraform__update_variable_set",
      "mcp__plugin_terraform_terraform__cancel_run",
      "mcp__plugin_terraform_terraform__discard_run"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/servarr-doctor/scripts/doctor.sh\" --quick || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_terraform_terraform__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tfc-workspace-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
